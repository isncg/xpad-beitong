 # Maintainer: 675076143 <675076143@qq.com>
 #
-# Patch by Zixing Liu that adds FLAG_FORCE_INIT to xpad.c, sending GIP
-# (Game Input Protocol) initialization packets (ACK + ANNOUNCE) to Beitong
-# KP-series 2.4G gamepads during probing, fixing the firmware's
-# OS-detection-based disconnect loop.
+# Patched xpad for Beitong/Betop KP-series controllers (VID 0x20bc).
+#
+# Background
+# ----------
+# These controllers boot into an Xbox personality and only stay there if the
+# host completes the handshake Windows performs while enumerating. Linux USB
+# core never does, so the firmware power-cycles itself through its remaining
+# personalities and finally settles on Nintendo Switch Pro Controller
+# emulation (057e:2009). Steam then reports a "Nintendo" controller.
+#
+# What changed in 2.0
+# -------------------
+# * 1.0 shipped Zixing Liu's FLAG_FORCE_INIT alone, which only sends Xbox One
+#   GIP init packets. Measured on a wired BTP-KP20D (20bc:5158): xpad binds
+#   and the packets do go out, but the firmware still switches away ~2s later.
+#   GIP packets alone are not sufficient.
+# * 2.0 adds the Microsoft OS descriptor request at index 0xEE - the request
+#   Windows issues while discovering the "XUSB10" compatible ID, and the one
+#   that actually pins this firmware to XInput. Verified on hardware: the
+#   device answers it with 0 and then stays on 20bc:5158 indefinitely.
+#   GIP init packets are kept for the other KP models.
+# * The handshake now runs from probe() as well as on input open. The
+#   firmware's decision window is only ~2s, which userspace opening
+#   /dev/input/eventX cannot be relied on to beat.
+#
+# xpad.c is fetched from the matching kernel tag instead of being read out of
+# linux-headers: Arch's linux-headers ships headers only, no driver sources,
+# so the 1.0 prepare() could never succeed.
+# When Arch bumps the kernel, bump _kbase and the sha256sums entry.
+# The patch is small and applies with offsets, so a newer base usually works
+# even without bumping.
+
+_kbase=7.2.8
 
 pkgname=xpad-beitong-dkms
-pkgver=1.0
+pkgver=2.0
 pkgrel=1
-pkgdesc='DKMS module for patched xpad with Beitong KP-series 2.4G gamepad fix'
+pkgdesc='DKMS module for patched xpad with Beitong/Betop KP-series XInput handshake'
 arch=('any')
 url='https://github.com/675076143/xpad-beitong-dkms'
-license=('GPL2')
+license=('GPL-2.0-only')
 depends=('dkms')
+makedepends=('linux-headers')
 install="${pkgname}.install"
 source=(
-  'beitong-gip-init.patch'
+  "xpad.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/input/joystick/xpad.c?h=v${_kbase}"
+  'beitong-ms-os-xinput.patch'
   'Makefile'
   'dkms.conf'
 )
-sha256sums=('SKIP' 'SKIP' 'SKIP')
+sha256sums=('19dd00fc4b0341ef18575a87b9b3fbd5f809e4588ff2909e2c357af2f2358517'
+            'eae0fab6a391334421a9717ef117807d7895ea227d5f9bb5773a50a9e42bdec4'
+            '73b8c36fe16fe1dd000c0fc397b2b97474856b1365e5187b9ff038247faf3940'
+            '70d2b1ddee18c63c46ea7bc8ffdfb29c6afdfcb79c5868b00a5b98bbfb611152')
 
 prepare() {
-  local src
-  for d in /usr/lib/modules/*/build/drivers/input/joystick; do
-    if [[ -f "${d}/xpad.c" ]]; then
-      src="${d}/xpad.c"
-      break
-    elif [[ -f "${d}/xpad.c.zst" ]]; then
-      src="${d}/xpad.c.zst"
-      break
-    fi
-  done
-
-  if [[ -z "${src}" ]]; then
-    error 'xpad.c not found in any kernel headers'
-    error 'Install linux-headers for your running kernel (e.g. linux-headers)'
-    exit 1
-  fi
-
-  msg2 "Using xpad.c from: ${src}"
-
-  if [[ "${src}" == *.zst ]]; then
-    zstd -d -f "${src}" -o "${srcdir}/xpad.c"
-  else
-    cp "${src}" "${srcdir}/xpad.c"
-  fi
+  cd "${srcdir}"
 
-  msg2 "Copied xpad.c ($(wc -l < xpad.c) lines)"
+  # makepkg links non-archive sources into $srcdir rather than copying them,
+  # and patch(1) refuses to operate on a symlink ("not a regular file").
+  # Materialise a real file first; cp -L + mv so we never write back through
+  # the symlink into the source directory.
+  cp -L xpad.c xpad.c.prepared
+  mv -f xpad.c.prepared xpad.c
 
-  cd "${srcdir}"
-  patch -Np0 -i beitong-gip-init.patch
+  patch -Np0 -i beitong-ms-os-xinput.patch
 }
 
 build() {
   cd "${srcdir}"
 
-  local running_kernel="$(uname -r)"
-  local kdir="/usr/lib/modules/${running_kernel}/build"
-
+  local kdir="/usr/lib/modules/$(uname -r)/build"
   if [[ ! -d "${kdir}" ]]; then
-    warning "Kernel build dir not found for ${running_kernel}. DKMS will build at install time."
+    echo "WARNING: kernel build dir for $(uname -r) not found; DKMS will build at install time." >&2
     return 0
   fi
 
-  msg2 "Building for kernel ${running_kernel}..."
-  make -C "${kdir}" M="${srcdir}" LLVM=1 modules
+  echo "Building for kernel $(uname -r)..."
