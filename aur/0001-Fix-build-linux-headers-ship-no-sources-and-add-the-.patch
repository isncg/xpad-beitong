++/*
++ * Microsoft OS descriptors
++ *
++ * Windows discovers a device's "XUSB10" compatible ID by requesting the
++ * Microsoft OS descriptor at index 0xEE while enumerating. The Linux USB
++ * core never issues that request, and the Beitong/Betop KP-series firmware
++ * treats its absence as "this host is not an XInput host" and power-cycles
++ * itself into Nintendo Switch emulation (057e:2009).
++ *
++ * Verified on a wired BTP-KP20D (20bc:5158): the firmware does NOT answer
++ * the standard GET_DESCRIPTOR(STRING, 0xEE) - it times out - but it does
++ * answer the literal vendor request bRequest=0xee, wValue=0, wIndex=4.
++ * That single request is what pins it to XInput, so send it first while the
++ * firmware's ~2s decision window is still open. The standard-descriptor and
++ * compatible-ID forms are kept as fallbacks for other KP models.
++ *
++ * All requests go through usb_control_msg_recv(), which bounces the buffer;
++ * plain usb_get_descriptor()/usb_control_msg() would DMA-map our stack
++ * buffer and trip "transfer buffer is on stack" in the HCD.
++ */
++static void xpad_query_ms_os_descriptor(struct usb_device *udev)
++{
++	static const u8 msft100[] = {
++		'M', 0, 'S', 0, 'F', 0, 'T', 0, '1', 0, '0', 0, '0', 0
++	};
++	u8 buf[40];
++	u8 vendor_code = 0x01;
++	int str_ret, code_ret, raw_ret;
++
++	/* The request that actually works on the wired BTP-KP20D. */
++	raw_ret = usb_control_msg_recv(udev, 0,
++				       /* bRequest */ 0xee,
++				       USB_TYPE_VENDOR | USB_DIR_IN |
++						USB_RECIP_DEVICE,
++				       /* wValue */ 0x0000,
++				       /* wIndex */ 0x0004,
++				       buf, sizeof(buf),
++				       100, GFP_KERNEL);
++
++	/* Fallback: standard MS OS string descriptor, which carries the
++	 * vendor request code the follow-up fetch should use. */
++	str_ret = usb_control_msg_recv(udev, 0,
++				       /* bRequest */ USB_REQ_GET_DESCRIPTOR,
++				       USB_DIR_IN | USB_RECIP_DEVICE,
++				       /* wValue */ (USB_DT_STRING << 8) | 0xee,
++				       /* wIndex */ 0x0000,
++				       buf, 18, 100, GFP_KERNEL);
++	if (!str_ret && buf[0] == 0x12 && buf[1] == USB_DT_STRING &&
++	    !memcmp(&buf[2], msft100, sizeof(msft100)))
++		vendor_code = buf[16];
